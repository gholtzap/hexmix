{
  "name": "avenlo-clone",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint:ui": "lintapple http://127.0.0.1:3001 --ready '[data-app-ready]' --json",
    "test": "node --test scripts/*.test.mts",
    "predev": "npm --prefix .. run build:browser",
    "prebuild": "npm --prefix .. run build:browser",
    "prestart": "npm --prefix .. run build:browser",
    "pretest": "npm --prefix .. run build:browser"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "lintapple": "0.1.20"
  }
}
