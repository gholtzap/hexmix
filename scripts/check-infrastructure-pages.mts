import assert from 'node:assert/strict';
import {mkdir,writeFile} from 'node:fs/promises';
import {chromium} from 'playwright';
import {expectUI} from 'lintapple/playwright';
const pages=['deployments','logs','analytics','speed-insights','observability','firewall','cdn','environment-variables','domains','connect','integrations','storage','flags','agent','ai-gateway','sandboxes','workflows','images','daemons','usage','support','settings'];
const out='artifacts/infrastructure/main-pages';await mkdir(out,{recursive:true});
const browser=await chromium.launch(),reports=[],errors=[];
async function audit(page,state,width,theme){await page.waitForTimeout(100);let report={findings:[]};try{await expectUI(page,{attach:async(_,data)=>report=JSON.parse(String(data.body))});}catch(e){if(!report.findings.length)throw e;}reports.push({state,width,theme,report});console.log(state,width,theme,report.findings.length);if(theme==='light'&&state.includes(' ')){await page.evaluate(()=>Object.entries({text:'#ededed',background:'#000000',primary:'#ededed',secondary:'#1f1f1f',accent:'#a1a1a1'}).forEach(([k,v])=>document.documentElement.style.setProperty('--p-'+k,v)));await audit(page,state,width,'dark');await page.evaluate(()=>Object.entries({text:'#171717',background:'#ffffff',primary:'#171717',secondary:'#eeeeee',accent:'#626262'}).forEach(([k,v])=>document.documentElement.style.setProperty('--p-'+k,v)));}}
try{for(const width of [1440,390]){const context=await browser.newContext({viewport:{width,height:900}}),page=await context.newPage();page.on('pageerror',e=>errors.push(e.message));for(const id of pages){await page.goto(`http://127.0.0.1:3000/dashboard-previews/infrastructure?page=${id}`);await page.locator('[data-app-ready]').waitFor();await page.locator('h1').waitFor();assert.ok(await page.locator('.vp-page').count());assert.equal(await page.locator('.vc-upgrade-notice,.vc-sidebar-footer').count(),0);assert.deepEqual(await page.locator('.vc-sidebar-links .vc-nav-link').evaluateAll(es=>es.map(e=>e.querySelector('span').textContent)),['Projects','Deployments','Logs','Analytics','Speed Insights','Observability','Firewall','CDN','Environment Variables','Domains','Connect','Integrations','Storage','Flags','Agent','AI Gateway']);for(const theme of ['dark','light']){if(theme==='light')await page.evaluate(()=>Object.entries({text:'#171717',background:'#ffffff',primary:'#171717',secondary:'#eeeeee',accent:'#626262'}).forEach(([k,v])=>document.documentElement.style.setProperty('--p-'+k,v)));await audit(page,id,width,theme);if(width===390){await page.locator('.vc-mobile-tools').getByRole('button',{name:'Open sidebar',exact:true}).click();await audit(page,id+'-sidebar',width,theme);await page.getByRole('button',{name:'Close sidebar',exact:true}).click();}}if(['deployments','logs','domains','settings','agent'].includes(id))await page.screenshot({path:`${out}/${id}-${width}.png`,fullPage:true});
 const search=page.getByRole('searchbox').first();if(await search.count()){await search.fill('zzzz-no-results');await audit(page,id+' empty',width,'light');await search.fill('');}
 const actions=page.locator('.vp-heading .primary');if(await actions.count()&&id!=='deployments'){await actions.first().click();if(await page.getByRole('dialog').count()){await audit(page,id+' form',width,'light');const submit=page.getByRole('dialog').locator('button[type=submit]');if(await submit.count()){await submit.click();await audit(page,id+' validation',width,'light');}await page.keyboard.press('Escape');}}
 const detail=page.locator('.vp-cell-action').first();if(await detail.count()){await detail.click();if(await page.getByRole('dialog').count()){await audit(page,id+' detail',width,'light');await page.keyboard.press('Escape');}}
 }await context.close();}assert.deepEqual(errors,[]);}finally{await browser.close();await writeFile(`${out}/ui-states.json`,JSON.stringify(reports,null,2));await writeFile(`${out}/browser-errors.json`,JSON.stringify(errors,null,2));}const n=reports.reduce((s,r)=>s+r.report.findings.length,0);console.log(`${reports.length} states; ${n} findings`);if(n)process.exitCode=1;
