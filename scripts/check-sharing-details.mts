import assert from 'node:assert/strict';
import {mkdir,writeFile,readFile} from 'node:fs/promises';
import {chromium,type Page} from 'playwright';
import {checkPage} from 'lintapple';
import {clickToolbarAction} from './lib/studio-toolbar.mts';
const base=process.env.APP_URL||'http://127.0.0.1:3300',out='artifacts/shareability/details';
await mkdir(out,{recursive:true});
const browser=await chromium.launch(),checks:string[]=[],snapshots:string[]=[],errors:string[]=[],reports:unknown[]=[];
const policy=JSON.parse(await readFile('ui-policy.json','utf8'));
async function audit(p:Page,state:string){reports.push({state,report:await checkPage(p,policy)});}
const context=await browser.newContext({viewport:{width:1440,height:900},permissions:['clipboard-read','clipboard-write']});
const page=await context.newPage();page.setDefaultTimeout(15000);page.on('pageerror',e=>errors.push(e.message));
async function ready(p:Page){await p.locator('[data-app-ready]').waitFor();}
async function share(){await page.evaluate(()=>navigator.clipboard.writeText(''));await clickToolbarAction(page,'Share palette');let link='';for(let i=0;i<150;i++){link=await page.evaluate(()=>navigator.clipboard.readText());if(/^http/.test(link))break;await new Promise(r=>setTimeout(r,100));}assert.match(link,/^http/);const id=/\/s\/([a-f0-9]{32})/.exec(link)?.[1];if(id)snapshots.push(id);return link;}
async function fresh(link:string){const c=await browser.newContext({viewport:{width:390,height:844}}),p=await c.newPage();p.setDefaultTimeout(15000);await p.goto(link);await ready(p);return{c,p};}
let complete=false;
try{
 await page.goto(`${base}/dashboards/infra-dashboard/environment-variables`);await ready(page);const f=page.frameLocator('iframe');await f.getByRole('button',{name:'Create Variable',exact:true}).click();await f.getByLabel('Name',{exact:true}).fill('SHARED_SAMPLE');await f.getByLabel('Value',{exact:true}).fill('protected-test-value');const link=await share();assert.equal(await f.getByLabel('Value',{exact:true}).inputValue(),'protected-test-value');assert(!page.url().includes('protected-test-value'));const id=snapshots.at(-1)!;const body=await(await page.request.get(`${base}/api/shares/${id}`)).text();assert(!body.includes('protected-test-value'));const{c,p}=await fresh(link);assert.equal(await p.frameLocator('iframe').getByLabel('Name',{exact:true}).inputValue(),'SHARED_SAMPLE');assert.equal(await p.frameLocator('iframe').getByLabel('Value',{exact:true}).inputValue(),'');await audit(p,'protected-field-restored');await p.screenshot({path:`${out}/protected-field-restored.png`});await c.close();checks.push('Environment variable draft restores with its protected value removed; sender value stays intact');
 await f.getByRole('button',{name:'Close dialog',exact:true}).click();const closed=await share();const closedId=/\/s\/([a-f0-9]{32})/.exec(closed)![1];assert(!(await(await page.request.get(`${base}/api/shares/${closedId}`)).text()).includes('protected-test-value'));checks.push('Closed private drafts remain protected');
 await page.goto(`${base}/orvian`);await ready(page);const of=page.frameLocator('iframe');await of.locator('[data-open-demo]').first().click();await of.getByLabel('First name',{exact:true}).fill('Shared sample');await of.getByRole('button',{name:'Continue to booking →',exact:true}).click();const ol=await share();const{c:oc,p:op}=await fresh(ol);await op.frameLocator('iframe').getByRole('dialog').waitFor();assert.equal(await op.frameLocator('iframe').getByLabel('First name',{exact:true}).inputValue(),'Shared sample');assert.equal(await op.frameLocator('iframe').getByLabel('Company email',{exact:true}).getAttribute('aria-invalid'),'true');await audit(op,'demo-errors-restored');await op.screenshot({path:`${out}/demo-errors-restored.png`});await oc.close();checks.push('Demo draft, open dialog, and validation errors restore without submission');
 const invalid=await page.request.post(`${base}/api/shares`,{data:{v:2},headers:{origin:base}});assert.equal(invalid.status(),400);assert.equal((await page.request.post(`${base}/api/shares`,{data:{},headers:{origin:'https://external.example'}})).status(),403);assert.equal((await page.request.get(`${base}/api/shares/not-valid`)).status(),404);checks.push('Invalid payload, external origin, and invalid snapshot ID are rejected');
 await page.setViewportSize({width:390,height:844});await page.goto(`${base}/compare`);await ready(page);await page.getByRole('button',{name:'Show palette B',exact:true}).first().click();const bf=await(await page.locator('iframe[title="Palette B preview"]').elementHandle())!.contentFrame();await bf!.locator('[data-comparison-toolbar]').waitFor();await clickToolbarAction(bf!,'Compare palettes');await page.getByRole('dialog',{name:'Comparison options for palette B',exact:true}).waitFor();await page.getByLabel('Preview',{exact:true}).selectOption('infrastructure');await page.getByRole('button',{name:'Copy comparison link',exact:true}).click();let cl='';for(let i=0;i<150;i++){cl=await page.getByLabel('Comparison link',{exact:true}).inputValue();if(cl.includes('state=')||cl.includes('/s/'))break;await new Promise(r=>setTimeout(r,100));}const ci=/\/s\/([a-f0-9]{32})/.exec(cl)?.[1];if(ci)snapshots.push(ci);const{c:cc,p:cp}=await fresh(cl);await cp.getByRole('dialog',{name:'Comparison options for palette B',exact:true}).waitFor();assert.equal(await cp.getByLabel('Preview',{exact:true}).inputValue(),'infrastructure');assert.equal(await cp.locator('.comparison-option[data-active=true]').getAttribute('aria-labelledby'),'palette-b');await audit(cp,'comparison-restored');await cp.screenshot({path:`${out}/comparison-restored.png`});await cc.close();checks.push('Comparison restores palette B, options, and selected preview');
 await page.goto(`${base}/editor`);await ready(page);await page.evaluate(()=>{Object.defineProperty(navigator.clipboard,'writeText',{value:async()=>{throw new Error('Test clipboard blocked');},configurable:true});document.execCommand=()=>false;});await clickToolbarAction(page,'Share palette');await page.getByRole('textbox',{name:'Text to copy',exact:true}).waitFor();const fallback=await page.getByRole('textbox',{name:'Text to copy',exact:true}).inputValue();assert.match(fallback,/^http/);const{c:fc,p:fp}=await fresh(fallback);assert.equal(new URL(fp.url()).pathname,'/editor');await audit(page,'clipboard-fallback');await page.screenshot({path:`${out}/clipboard-fallback.png`});await fc.close();checks.push('Blocked clipboard displays the complete link for manual copy');
 await page.goto(`${base}/editor?snapshot=invalid`);await page.getByRole('heading',{name:'Shared view unavailable',exact:true}).waitFor();await audit(page,'snapshot-error');await page.screenshot({path:`${out}/snapshot-error.png`});checks.push('Missing snapshot displays a retry page');assert.deepEqual(errors,[]);complete=true;
}finally{await browser.close();await writeFile(`${out}/report.json`,JSON.stringify({complete,checks,snapshots,errors,reports},null,2));}
console.log(`${checks.length} detailed share checks passed.`);

const findings=(reports as {report:{findings:unknown[]}}[]).reduce((n,r)=>n+r.report.findings.length,0);console.log(`${findings} UI findings in detailed states.`);if(findings)process.exitCode=1;
