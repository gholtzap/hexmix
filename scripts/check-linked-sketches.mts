import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {expect} from 'playwright/test';
import {checkBug} from './lib/bug-flow.mts';
await checkBug('HX-052','/compare?preview=workspace',async({page,context,width,audit})=>{
 const child=async(side)=>{const outer=await (await page.locator(`iframe[title="Palette ${side} preview"]`).elementHandle()).contentFrame();await outer.frameLocator('iframe').getByRole('button',{name:'Add files and more',exact:true}).waitFor({state:'attached'});return outer.childFrames()[0];};
 const a=await child('A'),b=await child('B'),canvas=f=>f.locator('canvas'),picture=async f=>createHash('sha256').update(await canvas(f).evaluate((x:HTMLCanvasElement)=>x.toDataURL())).digest('hex');
 await a.getByRole('button',{name:'Add files and more',exact:true}).click();await a.getByRole('menuitem',{name:'Sketch',exact:true}).click();await canvas(b).waitFor({state:'attached'});const blankA=await picture(a),blankB=await picture(b);
 const box=await canvas(a).boundingBox();await page.mouse.move(box.x+box.width*.25,box.y+box.height*.25);await page.mouse.down();await page.mouse.move(box.x+box.width*.75,box.y+box.height*.75,{steps:12});await page.mouse.up();const paintedA=await picture(a);assert.notEqual(paintedA,blankA);await expect.poll(()=>picture(b)).toBe(paintedA);await audit('mouse-a',a);
 if(width<=760)await page.getByRole('button',{name:'Show palette B',exact:true}).filter({visible:true}).first().click();await b.getByRole('button',{name:'Clear',exact:true}).click();await expect.poll(()=>picture(a)).toBe(blankA);assert.equal(await picture(b),blankB);
 const cdp=await context.newCDPSession(page);await cdp.send('Emulation.setTouchEmulationEnabled',{enabled:true});await page.waitForTimeout(100);const touchBox=await canvas(b).boundingBox();const point={x:touchBox.x+touchBox.width*.2,y:touchBox.y+touchBox.height*.3};await cdp.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[point]});for(let n=1;n<=8;n++)await cdp.send('Input.dispatchTouchEvent',{type:'touchMove',touchPoints:[{x:point.x+touchBox.width*.6*n/8,y:point.y+touchBox.height*.3*n/8}]});await cdp.send('Input.dispatchTouchEvent',{type:'touchEnd',touchPoints:[]});const paintedB=await picture(b);assert.notEqual(paintedB,blankB);await expect.poll(()=>picture(a)).toBe(paintedB);await audit('touch-b',b);
 await b.getByRole('button',{name:'Attach sketch',exact:true}).click();await expect.poll(()=>a.locator('.chat-input-area .attachment').allTextContents()).toEqual(['sketch.png']);await expect.poll(()=>b.locator('.chat-input-area .attachment').allTextContents()).toEqual(['sketch.png']);
});
