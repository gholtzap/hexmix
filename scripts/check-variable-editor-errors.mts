import assert from 'node:assert/strict';
import {checkBug} from './lib/bug-flow.mts';
await checkBug('HX-045','/dashboards/infra-dashboard/environment-variables',async({frame:f,audit})=>{
 const edit=async(name)=>{await f.getByRole('button',{name:`Actions for ${name}`,exact:true}).click();await f.getByRole('menuitem',{name:'Edit',exact:true}).click();await f.evaluate(()=>new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve))));};
 await edit('NEXT_PUBLIC_SITE_URL');await f.getByRole('textbox',{name:'Name',exact:true}).fill('bad-key');await f.getByRole('button',{name:'Save changes',exact:true}).click();assert.match(await f.locator('p[role=alert]').innerText(),/uppercase/);await audit('invalid-first');
 await f.getByRole('button',{name:'Cancel',exact:true}).click();await edit('DATABASE_URL');assert.equal(await f.getByRole('textbox',{name:'Name',exact:true}).inputValue(),'DATABASE_URL');assert.equal(await f.locator('p[role=alert]').count(),0);await audit('valid-second');
 await f.getByRole('button',{name:'Cancel',exact:true}).click();await edit('NEXT_PUBLIC_SITE_URL');assert.equal(await f.getByRole('textbox',{name:'Name',exact:true}).inputValue(),'bad-key');await f.getByRole('textbox',{name:'Name',exact:true}).fill('NEXT_PUBLIC_SITE_URL');await f.getByRole('button',{name:'Save changes',exact:true}).click();await f.getByRole('dialog').waitFor({state:'hidden'});await f.getByRole('searchbox',{name:'Search environment variables',exact:true}).fill('no-matching-variable');await f.getByRole('searchbox',{name:'Search environment variables',exact:true}).press('Tab');assert.equal(await f.getByText('No results',{exact:true}).count(),1);await audit('saved-empty-results');
});
