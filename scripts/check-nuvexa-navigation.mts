import assert from 'node:assert/strict';
import {checkBug} from './lib/bug-flow.mts';
await checkBug('HX-066','/nuvexa/contact',async({frame:f,page,width,audit})=>{
 await f.waitForLoadState('networkidle');const header=f.locator('nav.mh-header').filter({visible:true}).first();
 if(width<768){const menu=header.getByRole('button',{name:'Menu',exact:true});await menu.click();assert.equal(await menu.getAttribute('aria-expanded'),'true');await audit('mobile-menu',null);await menu.click();assert.equal(await menu.getAttribute('aria-expanded'),'false');return;}
 const trigger=header.getByRole('button',{name:'Platform',exact:true});await trigger.hover();assert.equal(await trigger.getAttribute('aria-expanded'),'true');const panel=header.locator('[data-framer-name="Distributors Panel"]');assert.equal(await panel.evaluate(e=>getComputedStyle(e).opacity),'1');await audit('platform-hover',null);await trigger.press('Escape');assert.equal(await trigger.getAttribute('aria-expanded'),'false');await trigger.press('ArrowDown');assert.equal(await panel.locator('a').first().evaluate(e=>document.activeElement===e),true);await panel.locator('a').first().press('Escape');assert.equal(await trigger.getAttribute('aria-expanded'),'false');
 await header.getByRole('button',{name:'Ways to work',exact:true}).hover();await audit('solutions-menu',null);await trigger.hover();const link=panel.locator('a[data-preview-path="/products/quotes-and-tenders"]').first();await link.click();await page.waitForURL(u=>u.pathname==='/nuvexa/products/quotes-and-tenders');await page.locator('iframe[data-preview-ready=true]').waitFor();
});
