import assert from 'node:assert/strict';
import {checkBug,openInfraPage} from './lib/bug-flow.mts';
await checkBug('HX-048','/dashboards/infra-dashboard',async({frame:f,audit})=>{
 await f.getByRole('button',{name:'Add New',exact:true}).click();await f.getByRole('menuitem',{name:'Project',exact:true}).click();await f.getByRole('textbox',{name:'Project name',exact:true}).fill('new-resource-project');await f.getByRole('button',{name:'Create Project',exact:true}).click();await f.getByRole('button',{name:'new-resource-project',exact:true}).waitFor();
 await openInfraPage(f,'Environment Variables');await f.getByRole('button',{name:'Create Variable',exact:true}).click();const dialog=f.getByRole('dialog');const project=dialog.getByRole('combobox',{name:'Project',exact:true});assert((await project.locator('option').allTextContents()).includes('new-resource-project'));
 await dialog.getByRole('textbox',{name:'Name',exact:true}).fill('HUNT_TOKEN');await dialog.getByLabel('Value',{exact:true}).fill('local-test-value');await project.selectOption('new-resource-project');await audit('variable-project');await dialog.getByRole('button',{name:'Create Variable',exact:true}).click();await dialog.waitFor({state:'hidden'});const row=f.getByRole('row').filter({has:f.getByRole('button',{name:'HUNT_TOKEN',exact:true})});assert((await row.innerText()).includes('new-resource-project'));
 await openInfraPage(f,'Projects');await f.getByRole('button',{name:'new-resource-project',exact:true}).waitFor();await openInfraPage(f,'Domains');await f.getByRole('button',{name:'Connect External',exact:true}).click();await dialog.getByRole('textbox',{name:'Domain',exact:true}).fill('new.example.com');await dialog.getByRole('combobox',{name:'Project',exact:true}).selectOption('new-resource-project');await audit('domain-project');await dialog.getByRole('button',{name:'Connect External',exact:true}).click();await dialog.waitFor({state:'hidden'});await f.getByRole('searchbox',{name:'Search any domain',exact:true}).fill('new.example.com');assert((await f.getByRole('row').filter({has:f.getByRole('button',{name:'new.example.com',exact:true})}).innerText()).includes('new-resource-project'));await audit('domain-created');
});
