import {clickToolbarAction} from './lib/studio-toolbar.mts';
import assert from 'node:assert/strict';
import {mkdir,writeFile} from 'node:fs/promises';
import {chromium} from 'playwright';
import {expectUI} from 'lintapple/playwright';
const output='artifacts/infrastructure';await mkdir(output,{recursive:true});
const browser=await chromium.launch();const reports=[],errors=[];
async function audit(page,state,width){
 await page.waitForFunction(()=>!document.getAnimations().some(a=>a.playState==='running'&&a.effect?.getComputedTiming().iterations!==Infinity));
 for(const theme of ['dark','light']){
  if(theme==='light')await page.evaluate(()=>Object.entries({text:'#171717',background:'#ffffff',primary:'#171717',secondary:'#eeeeee',accent:'#626262'}).forEach(([key,value])=>document.documentElement.style.setProperty('--p-'+key,value)));
  await page.waitForFunction(()=>!document.getAnimations().some(a=>a.playState==='running'&&a.effect?.getComputedTiming().iterations!==Infinity));
  let report={findings:[]};try{await expectUI(page,{attach:async(_,data)=>report=JSON.parse(String(data.body))});}catch(error){if(!report?.findings?.length)throw error;}
  reports.push({state,width,theme,report});
 }
 await page.evaluate(()=>Object.entries({text:'#ededed',background:'#000000',primary:'#ededed',secondary:'#1f1f1f',accent:'#a1a1a1'}).forEach(([key,value])=>document.documentElement.style.setProperty('--p-'+key,value)));
}
try{
 for(const width of [1440,390]){
  const context=await browser.newContext({viewport:{width,height:width===390?844:900}});const page=await context.newPage();page.on('pageerror',error=>errors.push(error.message));page.on('console',message=>{if(message.type()==='error')errors.push(message.text());});
  await page.goto('http://127.0.0.1:3000/dashboard-previews/infrastructure');await page.locator('[data-app-ready]').waitFor();assert.equal(await page.locator('.vc-project').count(),12);
  await audit(page,'overview',width);await page.screenshot({path:`${output}/overview-${width}.png`,fullPage:true});
  await page.getByRole('searchbox',{name:'Search projects',exact:true}).fill('atlas');assert.equal(await page.locator('.vc-project').count(),1);await page.getByRole('searchbox',{name:'Search projects',exact:true}).fill('zzzzzz');await page.getByText('No projects found',{exact:true}).waitFor();await audit(page,'empty search',width);await page.getByRole('button',{name:'Clear search and filters',exact:true}).click();
  await page.getByRole('button',{name:'Filter and Sort Projects',exact:true}).click();await audit(page,'filter menu',width);await page.getByRole('menuitem',{name:'Name',exact:true}).click();assert.equal(await page.locator('.vc-project-name').first().innerText(),'acme-web');
  await page.getByRole('button',{name:'Filter and Sort Projects',exact:true}).click();await page.getByRole('menuitem',{name:'Show only v0 projects',exact:true}).click();assert.equal(await page.locator('.vc-project').count(),2);await page.getByRole('button',{name:'Filter and Sort Projects',exact:true}).click();await page.getByRole('menuitem',{name:'Clear filters',exact:true}).click();
  if(width===1440){await page.getByRole('button',{name:'Grid view',exact:true}).click();assert.equal(await page.locator('.vc-project-list.grid').count(),1);assert.equal(new URL(page.url()).searchParams.get('view'),'grid');await audit(page,'project grid',width);await page.getByRole('button',{name:'List view',exact:true}).click();}
  await page.getByRole('button',{name:'Add New',exact:true}).click();await audit(page,'add menu',width);await page.getByRole('menuitem',{name:'Project',exact:true}).click();await audit(page,'new project dialog',width);assert.equal(await page.locator('[data-component=halaska-card-dialog]').count(),1);await page.getByRole('button',{name:'Create Project',exact:true}).click();await page.getByRole('alert').filter({hasText:'Enter a name.'}).waitFor();await audit(page,'project validation',width);await page.getByLabel('Project name',{exact:true}).fill('<b>bad</b>');await page.getByRole('button',{name:'Create Project',exact:true}).click();await page.getByRole('alert').filter({hasText:'Use 1–64'}).waitFor();await page.getByLabel('Project name',{exact:true}).fill('sample-project');await page.getByRole('button',{name:'Create Project',exact:true}).click();await page.getByRole('button',{name:'sample-project',exact:true}).waitFor();assert.equal(await page.locator('.vc-project').count(),12);
  await page.getByRole('button',{name:'sample-project',exact:true}).click();await audit(page,'project details',width);await page.getByRole('button',{name:'View Logs',exact:true}).click();await page.getByRole('heading',{name:'Logs',exact:true}).waitFor();await audit(page,'deployment logs',width);await page.goto('http://127.0.0.1:3000/dashboard-previews/infrastructure');await page.locator('[data-app-ready]').waitFor();
  if(width===390){await page.getByRole('radio',{name:'Usage',exact:true}).click();await audit(page,'mobile usage',width);}
  await page.getByRole('button',{name:'Show more usage',exact:true}).click();assert.equal(await page.locator('.vc-usage-metric').count(),10);await audit(page,'expanded usage',width);await page.getByRole('button',{name:'Show less usage',exact:true}).click();await page.getByRole('button',{name:'Billing',exact:true}).click();await page.getByRole('heading',{name:'Settings',exact:true}).waitFor();await audit(page,'billing page',width);await page.goto('http://127.0.0.1:3000/dashboard-previews/infrastructure');await page.locator('[data-app-ready]').waitFor();
  if(width===390){await page.getByRole('radio',{name:'Alerts',exact:true}).click();await audit(page,'mobile alerts',width);await page.getByRole('radio',{name:'Recents',exact:true}).click();await page.getByRole('button',{name:'Show more previews',exact:true}).click();await audit(page,'expanded previews',width);await page.getByRole('button',{name:'Show fewer previews',exact:true}).click();}
  await page.getByRole('button',{name:'Preview menu for Update the product collection page',exact:true}).click();await audit(page,'preview menu',width);await page.keyboard.press('Escape');
  if(width===390){await page.locator('.vc-mobile-tools').getByRole('button',{name:'Open sidebar',exact:true}).click();await audit(page,'mobile sidebar',width);}else{await page.getByRole('button',{name:'Project Menu · acme-web',exact:true}).click();await audit(page,'project menu',width);await page.getByRole('menuitem',{name:'Add Favorite',exact:true}).click();assert.equal(await page.locator('.vc-project-name [aria-label=Favorite]').count(),1);}
  await page.locator('.vc-sidebar').getByRole('button',{name:/Design studio/}).click();await audit(page,'team menu',width);await page.keyboard.press('Escape');assert.equal(await page.locator('.vc-sidebar-footer,.vc-upgrade-notice').count(),0);assert.equal(await page.locator('.vc-sidebar-links .vc-nav-link').last().innerText(),'AI Gateway');await page.locator('.vc-sidebar').getByRole('button',{name:'Find F',exact:true}).click();await audit(page,'find dialog',width);await page.locator('.vc-find-label input').fill('zzzzzz');await audit(page,'empty find',width);await page.keyboard.press('Escape');
  await page.getByRole('button',{name:'Open Agent',exact:true}).click();await audit(page,'Agent panel',width);await page.getByRole('textbox',{name:'Message Agent',exact:true}).fill('Summarize my projects');await page.getByRole('button',{name:'Send message',exact:true}).click();await page.getByText(/\d+ projects\./).waitFor();assert.equal(await page.locator('[data-component=aicss-text-response]').count(),1);await audit(page,'Agent response',width);await page.getByRole('button',{name:'Close Agent',exact:true}).click();
  await page.goto('http://127.0.0.1:3000/dashboards/infra-dashboard');await page.locator('[data-app-ready]').waitFor();const frame=page.frameLocator('iframe');await frame.locator('[data-app-ready]').waitFor();await clickToolbarAction(page, 'Use light palette');assert.notEqual(await frame.locator('html').evaluate(e=>e.style.getPropertyValue('--p-background')),'#000000');await clickToolbarAction(page, 'Reset palette and fonts');assert.equal(await frame.locator('html').evaluate(e=>e.style.getPropertyValue('--p-background')),'#000000');
  if(width===1440){await frame.getByRole('button',{name:'Grid view',exact:true}).click();assert.equal(new URL(page.url()).searchParams.get('view'),'grid');await page.reload();await frame.locator('[data-app-ready]').waitFor();assert.equal(await frame.locator('.vc-project-list.grid').count(),1);}
  await page.screenshot({path:`${output}/editor-${width}.png`});await context.close();
 }
 assert.deepEqual(errors,[]);console.log('Dashboard search, filters, forms, menus, details, Agent, responsive tabs, and editor actions passed.');
}finally{await browser.close();await writeFile(`${output}/ui-states.json`,JSON.stringify(reports,null,2));await writeFile(`${output}/browser-errors.json`,JSON.stringify(errors,null,2));}
const findings=reports.reduce((sum,item)=>sum+item.report.findings.length,0);console.log(`${reports.length} UI states checked; ${findings} findings. Report: ${output}/ui-states.json`);if(findings)process.exitCode=1;
