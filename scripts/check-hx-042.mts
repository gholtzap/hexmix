import assert from 'node:assert/strict';
import {runBugCheck} from './lib/confirmed-bug.mts';
await runBugCheck('HX-042','/dashboards/ai-chatbot/skills',async({frame,audit})=>{
 await frame.getByRole('button',{name:'New skill',exact:true}).click();const d=frame.getByRole('dialog');const name=d.getByLabel('Name',{exact:true}),instructions=d.getByLabel('Instructions',{exact:true});await name.fill('   ');await instructions.fill('Sample instructions');await d.getByRole('button',{name:'Save',exact:true}).click();assert.equal(await name.evaluate(n=>(n as HTMLInputElement).checkValidity()),false);assert.equal(await name.evaluate(n=>(n as HTMLInputElement).validationMessage),'Enter a name.');await audit(frame,'name-error');await name.fill('Sample skill');await instructions.fill('   ');await d.getByRole('button',{name:'Save',exact:true}).click();assert.equal(await instructions.evaluate(n=>(n as HTMLTextAreaElement).validationMessage),'Enter instructions.');await instructions.fill('Keep the sample clear.');await d.getByRole('button',{name:'Save',exact:true}).click();await frame.locator('.plug-skill').filter({hasText:'Sample skill'}).waitFor();await audit(frame,'skill-saved');
});
