import assert from 'node:assert/strict';
import {mkdir,writeFile} from 'node:fs/promises';
import {chromium} from 'playwright';
import {expectUI} from 'lintapple/playwright';
const out='artifacts/infrastructure/main-pages';await mkdir(out,{recursive:true});
const reports=[],errors=[];const browser=await chromium.launch();
const monitoring={analytics:['Visitors','Pageviews'],'speed-insights':['Desktop','Mobile'],observability:['Overview','Functions','Errors'],firewall:['Overview','Rules','Events'],cdn:['Overview','Cache','Paths'],'ai-gateway':['Overview','Models','Logs'],usage:['All usage','Compute','Network']};
let page,width,theme;
async function audit(state){await page.waitForTimeout(80);let report={findings:[]};try{await expectUI(page,{attach:async(_,data)=>report=JSON.parse(String(data.body))});}catch(e){if(!report.findings.length)throw e;}reports.push({state,width,theme,report});console.log(state,width,theme,report.findings.length);}
async function visit(id){await page.goto(`http://127.0.0.1:3000/dashboard-previews/infrastructure?page=${id}`);await page.locator('[data-app-ready]').waitFor();await page.locator('h1').waitFor();if(theme==='light')await page.evaluate(()=>Object.entries({text:'#171717',background:'#ffffff',primary:'#171717',secondary:'#eeeeee',accent:'#626262'}).forEach(([k,v])=>document.documentElement.style.setProperty('--p-'+k,v)));}
async function click(name,scope=page){await scope.getByRole('button',{name,exact:true}).click();}
async function close(){await page.keyboard.press('Escape');await page.getByRole('dialog').waitFor({state:'hidden'});}
try{for(width of [1440,390])for(theme of ['dark','light']){const context=await browser.newContext({viewport:{width,height:900}});page=await context.newPage();page.on('pageerror',error=>errors.push(error.message));
 for(const [id,tabs]of Object.entries(monitoring)){await visit(id);for(const tab of tabs){await click(tab);await audit(`${id} ${tab}`);}
 const filter=page.locator('.vp-filter [data-menu-trigger] button').first();await filter.click();await audit(`${id} filter menu`);await page.keyboard.press('Escape');
 if(id==='cdn'){await click('Purge cache');await audit('cdn cache confirmation');await click('Purge cache',page.getByRole('dialog'));await audit('cdn cache cleared');}
 if(id==='ai-gateway'){await click('API keys');await audit('gateway keys');await click('Create key',page.getByRole('dialog'));await audit('gateway key validation');assert.equal(await page.getByRole('dialog').getByRole('alert').innerText(),'Enter a key name.');await page.getByLabel('Key name',{exact:true}).fill('Test key');await click('Create key',page.getByRole('dialog'));await audit('gateway key created');await close();}
 if(id==='firewall'){await click('Add rule');await audit('firewall rule form');await click('Save rule',page.getByRole('dialog'));await audit('firewall rule validation');assert.equal(await page.getByRole('dialog').getByRole('alert').innerText(),'Enter a rule name.');await page.getByLabel('Rule name',{exact:true}).fill('Test rule');await click('Save rule',page.getByRole('dialog'));await page.getByText('Test rule',{exact:true}).waitFor();await audit('firewall rule created');await click('Pause 1');await audit('firewall rule paused');}
 }
 await visit('settings');await click('Members');await audit('settings members');await click('Invite member');await audit('settings invite');await click('Invite',page.getByRole('dialog'));await audit('settings invite validation');assert.equal(await page.getByRole('dialog').getByRole('alert').innerText(),'Enter a valid email address.');await page.getByLabel('Email',{exact:true}).fill('new@example.com');await click('Invite',page.getByRole('dialog'));await audit('settings invited member');await click('Billing');await audit('settings billing');
 await visit('support');await click('New case');await audit('support case form');await click('Create case',page.getByRole('dialog'));await audit('support case validation');await page.getByLabel('Subject',{exact:true}).fill('Test support case');await page.getByLabel('Message',{exact:true}).fill('Please check this sample project.');await click('Create case',page.getByRole('dialog'));await click('Test support case');await audit('support case detail');await click('Close case',page.getByRole('dialog'));await audit('support case closed');
 await visit('agent');await page.getByLabel('Message Agent',{exact:true}).fill('Review deployment errors');await click('Send message');await page.locator('[data-component="aicss-text-response"]').waitFor();await audit('agent response');
 await visit('storage');await page.getByRole('button',{name:'Actions for sample-db',exact:true}).click();await audit('storage row menu');await page.getByRole('menuitem',{name:'Delete',exact:true}).click();await audit('storage delete confirmation');await click('Confirm delete',page.getByRole('dialog'));await page.getByRole('searchbox').fill('nothing-matches');await audit('storage empty search');assert.equal(await page.getByText('No results',{exact:true}).count(),1);
 await context.close();}assert.deepEqual(errors,[]);
}catch(error){errors.push(error.stack??String(error));process.exitCode=2;}finally{await browser.close();await writeFile(`${out}/extra-ui.json`,JSON.stringify({reports,errors},null,2));}const findings=reports.reduce((sum,r)=>sum+r.report.findings.length,0);console.log(`${reports.length} states; ${findings} findings; ${errors.length} browser or check errors`);if(findings&&!process.exitCode)process.exitCode=1;
