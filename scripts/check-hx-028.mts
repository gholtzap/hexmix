const id='HX-028',widths=[390,1440];
async function verify(page,context,width,theme){
 const f=await go(page,'/dashboards/infra-dashboard');await f.getByRole('button',{name:'acme-web',exact:true}).first().click();await f.getByRole('dialog').getByRole('button',{name:'View Logs',exact:true}).click();await page.waitForURL(u=>u.pathname.endsWith('/logs'));
 await f.getByRole('button',{name:'Project: acme-web',exact:true}).waitFor();assert.deepEqual([...new Set(await f.locator('td[data-label=Host]').allTextContents())],['acme-web.example.com']);assert.equal(new URL(page.url()).searchParams.get('project'),'acme-web');await audit(page,'project logs');
 await f.getByRole('button',{name:'Project: acme-web',exact:true}).click();await f.getByRole('menuitem',{name:'All',exact:true}).click();await f.getByRole('button',{name:'Project: All',exact:true}).waitFor();assert(!new URL(page.url()).searchParams.has('project'));
 await page.reload();await page.locator('iframe[data-preview-ready=true]').waitFor();await f.getByRole('button',{name:'Project: All',exact:true}).waitFor();
 await f.getByRole('button',{name:'Project: All',exact:true}).click();await f.getByRole('menuitem',{name:'atlas-commerce',exact:true}).click();await f.getByRole('button',{name:'atlas-commerce.example.com',exact:true}).first().click();await f.getByRole('dialog').getByRole('button',{name:'View deployments',exact:true}).click();await page.waitForURL(u=>u.pathname.endsWith('/deployments'));await f.getByRole('heading',{name:'Deployments',exact:true}).waitFor();await f.getByRole('button',{name:'Project: atlas-commerce',exact:true}).waitFor();await page.waitForFunction(()=>{const doc=document.querySelector<HTMLIFrameElement>('iframe')?.contentDocument;const cells=[...(doc?.querySelectorAll('td[data-label=Project]')??[])];return cells.length>0&&cells.every(c=>c.textContent==='atlas-commerce');});await page.screenshot({path:`${output}/${width}-${theme}-deployment.png`});assert.deepEqual([...new Set(await f.locator('td[data-label=Project]').allTextContents())],['atlas-commerce']);assert.equal(new URL(page.url()).searchParams.get('project'),'atlas-commerce');await page.reload();await page.locator('iframe[data-preview-ready=true]').waitFor();await f.getByRole('button',{name:'Project: atlas-commerce',exact:true}).waitFor();await page.waitForFunction(()=>{const doc=document.querySelector<HTMLIFrameElement>('iframe')?.contentDocument;const cells=[...(doc?.querySelectorAll('td[data-label=Project]')??[])];return cells.length>0&&cells.every(c=>c.textContent==='atlas-commerce');});
}
import assert from 'node:assert/strict';
import {chromium} from 'playwright';
import {checkPage} from 'lintapple';
import {mkdir,readFile,writeFile} from 'node:fs/promises';
import {initialPalette,defaultDarkPalette,paletteQuery} from '../src/lib/palette.ts';
import {clickToolbarAction} from './lib/studio-toolbar.mts';
const base=process.env.APP_URL||'http://127.0.0.1:3340';
const output=`artifacts/${id}`;await mkdir(output,{recursive:true});
const policy=JSON.parse(await readFile('ui-policy.json','utf8')),reports=[],flows=[];
const browser=await chromium.launch();
async function go(page,path){const url=new URL(base+path);if(!url.searchParams.has('colors')){const dark=await page.evaluate(()=>matchMedia('(prefers-color-scheme: dark)').matches);url.searchParams.set('colors',new URLSearchParams(paletteQuery(dark?defaultDarkPalette:initialPalette)).get('colors'));}await page.goto(url.href);await page.locator('[data-app-ready]').waitFor();if(path.startsWith('/editor'))return null;await page.locator('iframe[data-preview-ready=true]').waitFor();const f=page.frameLocator('iframe');await f.locator('html[data-editor-ready=true],html[data-contrast-ready=true]').waitFor();return f;}
async function audit(page,state){await page.mouse.move(1,1);const report=await checkPage(page,policy);reports.push({state,width:page.viewportSize().width,report});}
try{for(const width of widths)for(const theme of ['light','dark'] as const){const context=await browser.newContext({viewport:{width,height:900},colorScheme:theme,reducedMotion:'reduce',permissions:['clipboard-read','clipboard-write']}),page=await context.newPage();page.setDefaultTimeout(15000);try{await verify(page,context,width,theme);await audit(page,'result');await page.screenshot({path:`${output}/${width}-${theme}.png`});flows.push({width,theme,passed:true});}finally{await context.close();}}}finally{await browser.close();await writeFile(`${output}/report.json`,JSON.stringify({flows,reports},null,2));}
assert.deepEqual(reports.flatMap(item=>item.report.findings),[]);
console.log(`${id}: ${flows.length} flows passed; ${reports.length} UI checks passed.`);
