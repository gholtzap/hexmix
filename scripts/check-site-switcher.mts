import assert from 'node:assert/strict';
import {mkdir,writeFile} from 'node:fs/promises';
import {chromium} from 'playwright';
import {expectUI} from 'lintapple/playwright';
import {previewCatalog,previewHref} from '../src/lib/preview-catalog.ts';
import {defaultDarkPalette,readPalette} from '../src/lib/palette.ts';
const out='artifacts/site-switcher';await mkdir(out,{recursive:true});
const browser=await chromium.launch(),reports=[],errors=[];
async function audit(page,state,width){let report={findings:[]};try{await expectUI(page,{attach:async(_,a)=>report=JSON.parse(String(a.body))});}catch(e){if(!report.findings.length)throw e;}reports.push({state,width,report});console.log(width,state,report.findings.length);}
try{for(const width of [1440,390]){const page=await browser.newPage({viewport:{width,height:900},reducedMotion:'reduce'});page.on('pageerror',e=>errors.push(e.message));for(const mode of ['dark','light']){const palette=mode==='dark'?defaultDarkPalette:{text:'#171717',background:'#ffffff',primary:'#171717',secondary:'#eeeeee',accent:'#626262'};
for(const site of previewCatalog){await page.goto('http://127.0.0.1:3000'+previewHref(site.path,palette,'Arial','Verdana'));await page.locator('[data-app-ready]').waitFor();await page.getByRole('button',{name:'Switch site: '+site.name,exact:true}).waitFor();await audit(page,site.id+' '+mode+' closed',width);await page.getByRole('button',{name:'Switch site: '+site.name,exact:true}).click();assert.equal(await page.getByRole('menuitem',{name:'All sites',exact:true}).count(),1);assert.equal(await page.getByRole('menuitem',{name:/^(Infrastructure|Workspace) pages$/}).count(),0);for(const target of previewCatalog){const link=page.getByRole('menuitem',{name:target.name,exact:true});assert.equal(await link.count(),1);const url=new URL(await link.getAttribute('href'),'http://localhost');assert.deepEqual(readPalette(url.search),palette);assert.equal(url.searchParams.get('heading'),'Arial');assert.equal(url.searchParams.get('body'),'Verdana');}
await audit(page,site.id+' '+mode+' menu',width);if(site.id==='infrastructure'&&mode==='dark')await page.screenshot({path:`${out}/switcher-${width}.png`});await page.keyboard.press('Escape');assert.equal(await page.getByRole('menu').count(),0);await page.waitForFunction(()=>document.activeElement?.matches('.site-switcher-trigger'));
}
await page.getByRole('button',{name:/Switch site:/}).click();await page.getByRole('menuitem',{name:'Avenlo',exact:true}).click();await page.waitForURL(/\/avenlo\?/);await page.locator('[data-app-ready]').waitFor();assert.deepEqual(readPalette(new URL(page.url()).search),palette);
await page.getByRole('button',{name:/Switch site:/}).click();await page.getByRole('menuitem',{name:'Infra Dashboard',exact:true}).click();await page.waitForURL(/\/dashboards\/infra-dashboard\?/);await page.locator('[data-app-ready]').waitFor();await page.getByRole('button',{name:'Fonts',exact:true}).click();assert.equal(await page.getByLabel('Headings',{exact:true}).inputValue(),'Arial');assert.equal(await page.getByLabel('Body',{exact:true}).inputValue(),'Verdana');await page.getByRole('button',{name:/Switch site:/}).click();assert.equal(await page.getByLabel('Headings',{exact:true}).count(),0);await page.getByRole('menuitem',{name:'All sites',exact:true}).click();await page.waitForURL(u=>u.pathname==='/');await page.locator('[data-app-ready]').waitFor();await audit(page,mode+' gallery',width);const gallery=page.getByRole('link',{name:'Infra Dashboard',exact:true});assert.equal(new URL(await gallery.getAttribute('href'),'http://localhost').searchParams.get('body'),'Verdana');await gallery.click();await page.waitForURL(/\/dashboards\/infra-dashboard\?/);await page.goBack();await page.locator('[data-app-ready]').waitFor();assert.equal(new URL(page.url()).pathname,'/');
}await page.close();}assert.deepEqual(errors,[]);}finally{await browser.close();await writeFile(`${out}/ui.json`,JSON.stringify(reports,null,2));await writeFile(`${out}/errors.json`,JSON.stringify(errors,null,2));}const n=reports.reduce((s,r)=>s+r.report.findings.length,0);console.log(`${reports.length} states; ${n} findings`);if(n)process.exitCode=1;
