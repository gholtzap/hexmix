import assert from 'node:assert/strict';
import {runBugCheck} from './lib/confirmed-bug.mts';
await runBugCheck('HX-033','/dashboards/ai-chatbot',async({page,frame,open,share,audit})=>{
 const show=async f=>{if(!await f.locator('[data-dot]').isVisible())await f.getByRole('button',{name:'Open sidebar',exact:true}).click();await f.locator('[data-dot]').click();};
 await show(frame);await frame.getByLabel('Personal context',{exact:true}).fill('Shared context for the sample task');await frame.getByRole('button',{name:'Save context',exact:true}).click();await show(frame);
 const link=await share();assert(!page.url().includes('Shared context'));const recipient=await open(link,{'pebble-context':'Recipient context to preserve'});
 assert.equal(await recipient.frame.getByLabel('Personal context',{exact:true}).inputValue(),'Shared context for the sample task');await audit(recipient.frame,'shared-context');
 await recipient.frame.getByLabel('Personal context',{exact:true}).fill('Edited shared context');await recipient.frame.getByRole('button',{name:'Save context',exact:true}).click();assert.equal(await recipient.frame.evaluate(()=>localStorage.getItem('pebble-context')),'Recipient context to preserve');await show(recipient.frame);assert.equal(await recipient.frame.getByLabel('Personal context',{exact:true}).inputValue(),'Edited shared context');await audit(recipient.frame,'edited-copy');
 await frame.getByRole('button',{name:'Close dialog',exact:true}).click();if(!await frame.locator('[data-nav=space]').isVisible())await frame.getByRole('button',{name:'Open sidebar',exact:true}).click();await frame.locator('[data-nav=space]').click();await page.goBack();await frame.locator('[data-dot]').waitFor({state:'attached'});await show(frame);await frame.getByLabel('Personal context',{exact:true}).fill('Local context after Back');await frame.getByRole('button',{name:'Save context',exact:true}).click();assert.equal(await frame.evaluate(()=>localStorage.getItem('pebble-context')),'Local context after Back');
});
