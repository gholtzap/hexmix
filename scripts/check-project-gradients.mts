import assert from 'node:assert/strict';
import {mkdir,readFile,writeFile} from 'node:fs/promises';
import {chromium} from 'playwright';
import sharp from 'sharp';
import {expectUI} from 'lintapple/playwright';
import {projects,projectGradients} from '../src/components/dashboards/infrastructure/data.ts';
const out='artifacts/project-gradients';await mkdir(out,{recursive:true});
assert.equal(new Set(projects.map(p=>p.gradient)).size,projects.length);
for(const asset of projectGradients){const bytes=await readFile('public'+asset),metadata=await sharp(bytes).metadata(),stats=await sharp(bytes).stats();assert.equal(metadata.width,128);assert.equal(metadata.height,128);assert(stats.channels.some(c=>c.stdev>5),'Gradient must have colour variation');}
const browser=await chromium.launch(),reports=[],errors=[];
async function audit(page,state,width,theme){await page.waitForFunction(()=>!document.getAnimations().some(a=>a.playState==='running'&&a.effect?.getComputedTiming().iterations!==Infinity));let report={findings:[]},attached=false;try{await expectUI(page,{attach:async(_,a)=>{report=JSON.parse(String(a.body));attached=true;}});}catch(e){if(!attached)throw e;}reports.push({state,width,theme,report});}
async function marks(page){return await page.locator('.vc-project').evaluateAll(es=>Object.fromEntries(es.map(e=>[e.querySelector('.vc-project-name').textContent,new URL(getComputedStyle(e.querySelector('.vc-project-avatar')).backgroundImage.slice(5,-2)).pathname])));}
try{for(const width of[1440,390])for(const theme of['dark','light']){
 const page=await browser.newPage({viewport:{width,height:900},reducedMotion:'reduce'});page.on('pageerror',e=>errors.push(e.message));await page.goto('http://127.0.0.1:3000/dashboard-previews/infrastructure');await page.locator('[data-app-ready]').waitFor();
 if(theme==='light')await page.evaluate(()=>Object.entries({text:'#171717',background:'#ffffff',primary:'#171717',secondary:'#eeeeee',accent:'#626262'}).forEach(([k,v])=>document.documentElement.style.setProperty('--p-'+k,v)));
 await page.getByRole('button',{name:'Show More',exact:true}).click();await page.locator('.vc-project').first().scrollIntoViewIfNeeded();const original=await marks(page);assert.deepEqual(original,Object.fromEntries(projects.map(p=>[p.name,p.gradient])));assert.equal(await page.locator('.vc-project-avatar svg').count(),0);await audit(page,'project list',width,theme);await page.screenshot({path:`${out}/projects-${width}-${theme}.png`});
 await page.getByRole('button',{name:'Filter and Sort Projects',exact:true}).click();await page.getByRole('menuitem',{name:'Name',exact:true}).click();assert.deepEqual(await marks(page),original);
 if(width===1440){await page.getByRole('button',{name:'Grid view',exact:true}).click();assert.deepEqual(await marks(page),original);await audit(page,'project grid',width,theme);await page.getByRole('button',{name:'List view',exact:true}).click();}
 await page.getByRole('button',{name:'Project Menu · acme-web',exact:true}).click();await audit(page,'gradient menu',width,theme);await page.keyboard.press('Escape');
 if(width===390)await page.locator('.vc-mobile-tools').getByRole('button',{name:'Open sidebar',exact:true}).click();await page.getByRole('button',{name:'Find F',exact:true}).click();const image=page.getByRole('dialog').locator('.vc-project-mark').first();await image.waitFor();await image.evaluate(e=>(e as HTMLImageElement).decode());assert.equal(await image.getAttribute('src'),projects[0].gradient);assert(await image.evaluate(e=>(e as HTMLImageElement).complete&&(e as HTMLImageElement).naturalWidth===128));await audit(page,'project search',width,theme);await page.keyboard.press('Escape');
 await page.getByRole('button',{name:'Add New',exact:true}).click();await page.getByRole('menuitem',{name:'Project',exact:true}).click();await page.getByLabel('Project name',{exact:true}).fill('gradient-check');await page.getByRole('button',{name:'Create Project',exact:true}).click();const created=(await marks(page))['gradient-check'];assert(projectGradients.includes(created));await page.getByRole('searchbox',{name:'Search projects',exact:true}).fill('gradient-check');assert.equal((await marks(page))['gradient-check'],created);await audit(page,'new project',width,theme);
 await page.goto('http://127.0.0.1:3000/dashboard-previews/infrastructure?page=deployments');await page.locator('[data-app-ready]').waitFor();if(theme==='light')await page.evaluate(()=>Object.entries({text:'#171717',background:'#ffffff',primary:'#171717',secondary:'#eeeeee',accent:'#626262'}).forEach(([k,v])=>document.documentElement.style.setProperty('--p-'+k,v)));
 const badge=page.locator('.vd-avatar').first();assert.equal(await badge.innerText(),'');assert((await badge.evaluate(e=>getComputedStyle(e).backgroundImage)).includes(projects[0].gradient));await audit(page,'deployment gradients',width,theme);await page.screenshot({path:`${out}/deployments-${width}-${theme}.png`});await page.close();
}assert.deepEqual(errors,[]);}finally{await browser.close();await writeFile(`${out}/ui.json`,JSON.stringify(reports,null,2));await writeFile(`${out}/errors.json`,JSON.stringify(errors,null,2));}
const findings=reports.reduce((n,r)=>n+r.report.findings.length,0);console.log(`${reports.length} UI states; ${findings} findings`);if(findings)process.exitCode=1;
