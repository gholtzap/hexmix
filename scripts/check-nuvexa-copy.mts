import {clickToolbarAction} from './lib/studio-toolbar.mts';
import assert from 'node:assert/strict';
import {mkdir,readFile,writeFile} from 'node:fs/promises';
import {chromium} from 'playwright';
import {expectUI} from 'lintapple/playwright';
const output='artifacts/nuvexa-copy';await mkdir(output,{recursive:true});
const browser=await chromium.launch(),reports=[],errors=[],states=[];
async function audit(page,state,width){let report={findings:[]};try{await expectUI(page,{attach:async(_,a)=>report=JSON.parse(String(a.body))});}catch(e){if(!report.findings.length)throw e;}reports.push({state,width,report});}
const oldCopy=/technical suppliers|quote|tender|ERP|BoQs|distributors|manufacturers|story-b|Sanitär|ISO certified|GDPR-compliant|Y Combinator/i;
async function verify(frame,label){let text='';for(let attempt=0;attempt<20;attempt++){text=await frame.locator('body').innerText();if(!oldCopy.test(text))break;await new Promise<void>(resolve=>setTimeout(resolve,50));}assert.ok(!oldCopy.test(text),label+': '+text.match(new RegExp('.{0,30}(?:'+oldCopy.source+').{0,80}','gi')));assert.ok(text.includes('Nuvexa'));states.push(label);}
try{for(const width of[1440,390]){const page=await browser.newPage({viewport:{width,height:900},reducedMotion:'reduce'});page.on('pageerror',e=>errors.push(e.message));await page.goto('http://127.0.0.1:3000/nuvexa');const frame=page.frameLocator('iframe');await frame.locator('html[data-copy-ready=true]').waitFor();await frame.getByRole('heading',{name:'A clearer path forward for your business.',exact:true}).waitFor();assert.ok(await frame.locator('.mh-header img[alt=Nuvexa]').first().evaluate(e=>(e as HTMLImageElement).currentSrc.startsWith('data:image/svg+xml')));await verify(frame,'homepage '+width);await audit(page,'homepage',width);await page.screenshot({path:`${output}/homepage-${width}.png`});
if(width===390){await frame.locator('.mh-header').getByRole('button').first().click();await verify(frame,'mobile menu');await audit(page,'mobile menu',width);await frame.locator('.mh-header').getByRole('button').first().click();}else{for(const label of['Platform','Ways to work']){await frame.locator('.mh-header').getByText(label,{exact:true}).first().hover();await verify(frame,label+' menu');await audit(page,label+' menu',width);}await frame.locator('.mh-header').getByText('Stories',{exact:true}).first().hover();}
await frame.getByRole('heading',{name:'Find a simpler way to move forward.',exact:true}).scrollIntoViewIfNeeded();
for(const label of['Getting started','Business planning','Next steps','Team coordination','Ongoing support']){const buttons=frame.locator('[data-framer-name="Label"]').getByText(label,{exact:true}).filter({visible:true});if(await buttons.count())await buttons.first().click();await verify(frame,'platform '+label+' '+width);}
await frame.locator('[data-framer-name="Customer Voice"]').getByRole('button',{name:'Next',exact:true}).click();await verify(frame,'next story '+width);await audit(page,'story carousel',width);await page.getByRole('button',{name:/Use (light|dark) palette/,exact:true}).click();await verify(frame,'palette change '+width);await audit(page,'palette change',width);await clickToolbarAction(page, 'Reset palette and fonts');await page.reload();await frame.locator('html[data-copy-ready=true]').waitFor();await verify(frame,'reload '+width);await frame.getByRole('link',{name:'Start a conversation',exact:true}).click();await page.waitForURL(u=>u.pathname==='/nuvexa/contact');states.push('contact navigation '+width);await page.close();}assert.deepEqual(errors,[]);}finally{await browser.close();await writeFile(`${output}/actions.json`,JSON.stringify({states,errors},null,2));await writeFile(`${output}/editor-ui.json`,JSON.stringify(reports,null,2));}const findings=reports.reduce((sum,r)=>sum+r.report.findings.length,0);console.log(`${states.length} content/action checks, ${reports.length} editor UI states, ${findings} editor findings.`);if(findings)process.exitCode=1;
